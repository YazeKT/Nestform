{
  "name": "nestform",
  "version": "0.4.0",
  "description": "Nestform: a modern desktop workspace for the Deepnest engine",
  "main": "out/main/index.js",
  "author": {
    "name": "Yaze Media",
    "email": "kirstentrimaley@gmail.com"
  },
  "companyName": "Yaze Media",
  "copyright": "Copyright © 2026 Kirsten Trimaley, trading as Yaze Media. Deepnest attribution is retained in the included notices.",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-runtime.cjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "native:build": "node-gyp rebuild --directory native --msvs_version=2022",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win portable",
    "release:win": "npm run build && electron-builder --win portable nsis",
    "bootstrap:win": "node scripts/bootstrap-win.cjs",
    "source:win": "pwsh -NoProfile -File scripts/package-source.ps1",
    "runtime:install": "install-electron",
    "icon:build": "electron scripts/build-icon.cjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "node-addon-api": "8.9.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "node-gyp": "13.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "media.yaze.nestform",
    "productName": "Nestform",
    "copyright": "Copyright © 2026 Kirsten Trimaley, trading as Yaze Media",
    "directories": {
      "output": "release/0.4.0"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE*",
      "THIRD-PARTY-NOTICES.md",
      "CHANGELOG.md",
      "docs/**/*"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/nestform.node",
        "to": "engine/nestform.node"
      },
      {
        "from": "vendor/legacy",
        "to": "engine/legacy"
      },
      {
        "from": "samples",
        "to": "samples"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "src/renderer/public/nestform.ico",
      "executableName": "Nestform",
      "legalTrademarks": "Nestform is a Yaze Media product"
    },
    "portable": {
      "artifactName": "Nestform-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "Nestform-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nestform",
      "uninstallDisplayName": "Nestform",
      "installerIcon": "src/renderer/public/nestform.ico",
      "uninstallerIcon": "src/renderer/public/nestform.ico"
    }
  }
}
